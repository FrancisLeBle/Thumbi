# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your secrets locally.
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

# Core App & AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_API_BASE_URL="http://localhost:8080"

# Application Environment (development, staging, production)
ENV="development"
PORT="8080"
SHUTDOWN_TIMEOUT="10s"

# CORS Whitelist (comma-separated origins allowed alongside https://localhost and capacitor://localhost)
ALLOWED_ORIGINS="https://localhost:3000,http://localhost:3000,http://localhost:5173"

# PostgreSQL Database Configuration
POSTGRES_USER="thumbi"
POSTGRES_PASSWORD="choose_a_strong_database_password_here"
POSTGRES_DB="thumbi_carpooling"
DATABASE_URL="postgres://thumbi:choose_a_strong_database_password_here@localhost:5432/thumbi_carpooling?sslmode=disable"
DB_MAX_CONNS="20"
DB_MIN_CONNS="5"

# Security & JWT Configuration
# CRITICAL: In production/staging, JWT_SECRET is REQUIRED and MUST be >= 32 characters/bytes.
JWT_SECRET="generate_a_cryptographically_secure_random_key_at_least_32_characters"
JWT_ISSUER="thumbi-auth-service"
SESSION_TTL="20m"

# Vehicle Approval Review Webhook (HMAC SHA-256 Secret)
# Required in production/staging to verify review provider webhooks.
WEBHOOK_SECRET="generate_a_cryptographically_secure_webhook_secret_at_least_32_chars"

# Third-party OAuth Providers
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
APPLE_CLIENT_ID="app.thumbi.carpooling.client"

# Biometrics & Fraud Detection
LIVENESS_THRESHOLD="0.85"

# Routing Engine (MUST use HTTPS for external endpoints, or an internal self-hosted OSRM instance)
OSRM_BASE_URL="https://router.project-osrm.org"
