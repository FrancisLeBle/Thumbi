# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local/development values.
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & HTTP Server
# ------------------------------------------------------------------------------
# Allowed values: "local", "development", "staging", "production"
# Outside "local"/"development", the backend enforces strict fail-fast startup
# validation on all secrets, database TLS, and OAuth client IDs.
ENV="development"
PORT="8080"
SHUTDOWN_TIMEOUT="10s"
APP_URL="http://localhost:3000"

# CORS Whitelist (comma-separated origins allowed alongside https://localhost and capacitor://localhost)
ALLOWED_ORIGINS="https://localhost:3000,http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# Frontend / Mobile Client Build-Time Public Config (NEVER put secrets in VITE_*)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# PostgreSQL + PostGIS Database (Required in ALL environments)
# Handles transactional data, opaque sessions, and optional rate limiting.
# ------------------------------------------------------------------------------
POSTGRES_USER="thumbi"
POSTGRES_PASSWORD="replace_with_local_dev_db_password"
POSTGRES_DB="thumbi_carpooling"
DATABASE_URL="postgres://thumbi:replace_with_local_dev_db_password@localhost:5432/thumbi_carpooling?sslmode=disable"
DB_MAX_CONNS="20"
DB_MIN_CONNS="5"

# ------------------------------------------------------------------------------
# Rate Limiting Backend (Zero Redis dependency)
# Allowed values: "memory" (in-memory thread-safe map) or "postgres" (UNLOGGED table)
# ------------------------------------------------------------------------------
RATE_LIMIT_STORE="memory"

# ------------------------------------------------------------------------------
# Session & Webhook Security (Required in ALL environments)
# ------------------------------------------------------------------------------
SESSION_TTL="20m"

# Generate locally with: openssl rand -hex 32
WEBHOOK_SECRET="replace_with_64_hex_char_secret_from_openssl_rand"

# ------------------------------------------------------------------------------
# Third-party OAuth Providers (Required outside local/development)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
APPLE_CLIENT_ID="app.thumbi.carpooling.client"

# ------------------------------------------------------------------------------
# Biometrics, Routing & Production External Providers
# ------------------------------------------------------------------------------
LIVENESS_THRESHOLD="0.85"

# Routing Engine (MUST use HTTPS for external endpoints, or an internal self-hosted OSRM instance)
OSRM_BASE_URL="https://router.project-osrm.org"

# Production External Provider Secrets (Required once mock adapters are replaced before ENV=production)
# PAYMENT_GATEWAY_API_KEY="replace_with_stripe_or_mercadopago_secret_key"
# PAYMENT_WEBHOOK_SECRET="replace_with_payment_gateway_webhook_signing_secret"
# BIOMETRICS_API_KEY="replace_with_kyc_biometrics_vendor_api_key"
# PUSH_NOTIFIER_API_KEY="replace_with_fcm_or_sns_server_credentials"
